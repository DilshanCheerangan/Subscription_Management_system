# Database connection with PgBouncer connection pooling for queries
DATABASE_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection for Prisma migrations
DIRECT_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Authentication secret for signed JWTs
AUTH_SECRET="your_32_character_base64_secret"

# Public application base URL
APP_URL="http://localhost:3000"

# SMTP Email Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
MAIL_FROM="Brightloop <no-reply@brightloop.test>"

# Billing Cron Job Secret
CRON_SECRET="your_long_random_cron_secret"

# Initial Admin Credentials (used during seed)
ADMIN_EMAIL="admin@brightloop.test"
ADMIN_PASSWORD="YourStrongAdminPassword!123"
